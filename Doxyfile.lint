# Documentation lint for first-party C++ modules. Run from the project root.
# Integration and provenance: docs/tooling.md and docs/sources.md.
PROJECT_NAME           = "C++ project (doc-lint)"
OUTPUT_DIRECTORY       = doxygen-lint-output
QUIET                  = YES
INPUT                  = src
RECURSIVE              = YES
FILE_PATTERNS          = *.cppm *.cpp
EXTENSION_MAPPING      = cppm=C++
EXCLUDE_PATTERNS       = */vendor/* */external/* */build/*
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_NAMESPACES  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
ENABLE_PREPROCESSING  = YES
MACRO_EXPANSION        = NO
PREDEFINED            = export=
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
