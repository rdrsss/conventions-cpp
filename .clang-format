# Shared C++ conventions.
# Use the selected compiler toolchain’s matching LLVM tools.
# Rationale and provenance: docs/tooling.md and docs/sources.md.
---
BasedOnStyle: LLVM
IndentWidth: 2
ColumnLimit: 130
PointerAlignment: Left
ReferenceAlignment: Left
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveMacros: Consecutive
ReflowComments: true
CommentPragmas: '^ IWYU pragma:|^!|^:|^@(file|brief|param|return|tparam|note|see|throws|pre|post)'
Standard: Latest
...
